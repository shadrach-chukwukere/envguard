{
  "name": "@chispecial/envguard",
  "version": "1.0.0",
  "description": "TypeScript-first environment variable validation library for Node.js applications.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "env",
    "environment",
    "configuration",
    "validation",
    "typescript",
    "env-variables",
    "envguard",
    "type-safe",
    "schema",
    "secrets"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "ci": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.0.0",
    "vitest": "^5.1.0"
  }
}
